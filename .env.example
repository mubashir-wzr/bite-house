# Supabase — server only (do NOT prefix the secret with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Legacy projects can use this instead:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=use-a-long-random-secret
ADMIN_EMAIL=you@example.com

# EmailJS — these are used by the Next.js server routes.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxx
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxx
EMAILJS_ADMIN_TEMPLATE_ID=template_xxxxxxx
EMAILJS_ORDER_ADMIN_TEMPLATE_ID=template_xxxxxxx
EMAILJS_ORDER_CUSTOMER_TEMPLATE_ID=template_xxxxxxx
EMAILJS_RESERVATION_TEMPLATE_ID=template_xxxxxxx
EMAILJS_CONTACT_TEMPLATE_ID=template_xxxxxxx
EMAILJS_ADMIN_EMAIL=you@example.com
